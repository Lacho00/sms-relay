{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sms-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sms-relay",
      "database_id": "4c690585-a465-416e-9d17-4bb6e6290bce",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "RETENTION_DAYS": "30",
    "MAX_ATTEMPTS": "10",
    "DISPLAY_TIMEZONE": "UTC",
    "TELEGRAM_API_BASE": "https://api.telegram.org",
    "ALERTS_ENABLED": "true"
  }
}
